{
  "expo": {
    "name": "TradeStamp",
    "slug": "tradestamp",
    "version": "1.0.142",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "buildNumber": "99",
      "bundleIdentifier": "com.tradestamp.journal"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0f19"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 99,
      "package": "com.tradestamp.journal"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-sqlite",
      "expo-font",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b1118",
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow TradeStamp to access the camera for profile photo",
          "photosPermission": "Allow TradeStamp to access your photo library for profile photo"
        }
      ],
      "@react-native-async-storage/expo-with-async-storage",
      "expo-sharing",
      "expo-image",
      "expo-file-system",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow TradeStamp to save summary card images to your photo library",
          "savePhotosPermission": "Allow TradeStamp to save summary card images to your photo library"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow TradeStamp to use the microphone for voice chat with the AI assistant"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1a56db",
          "sounds": []
        }
      ]
    ],
    "router": {
      "root": "src"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}